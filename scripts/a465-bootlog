#!/usr/bin/env python3
"""Record everything the controller prints on its console, for example while it is switched off and on.

Sends nothing. Writes sessions/<time>-boot.log and stops after --quiet seconds of silence once
something has been heard (default 45), or after --max seconds (default 12 hours).

    scripts/a465-bootlog            # then switch the controller off and on
"""
import argparse
import datetime
import os
import time

import serial

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--port", default=os.environ.get("A465_PORT", "/dev/ttyUSB0"))
    ap.add_argument("--baud", type=int, default=38400)
    ap.add_argument("--quiet", type=float, default=45.0)
    ap.add_argument("--max", type=float, default=12 * 3600.0)
    args = ap.parse_args()
    path = os.path.join(REPO, "sessions", datetime.datetime.now().strftime("%Y-%m-%d_%H%M%S") + "-boot.log")
    start, last, heard = time.monotonic(), None, 0
    with serial.Serial(args.port, args.baud, timeout=0, exclusive=True) as ser, open(path, "wb") as log:
        print(f"listening on {args.port}; writing {os.path.relpath(path, REPO)}", flush=True)
        while time.monotonic() - start < args.max:
            chunk = ser.read(4096)
            if chunk:
                if last is None:
                    print(f"first output at {datetime.datetime.now().strftime('%H:%M:%S')}", flush=True)
                log.write(chunk)
                log.flush()
                heard += len(chunk)
                last = time.monotonic()
            elif last is not None and time.monotonic() - last > args.quiet:
                break
            else:
                time.sleep(0.02)
    print(f"stopped: {heard} bytes recorded", flush=True)


if __name__ == "__main__":
    main()
