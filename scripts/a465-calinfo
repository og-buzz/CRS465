#!/usr/bin/env python3
"""Print what a copy of the controller's calibration file says.

    scripts/a465-calinfo                                   # the newest copy under controller/
    scripts/a465-calinfo controller/backup-2026-11-23/conf/robot.cal

Get a copy with scripts/a465-getfile /conf/robot.cal. The format is described in a465/calfile.py.
"""
import glob
import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, REPO)

from a465 import calfile      # noqa: E402


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    paths = sys.argv[1:] or sorted(glob.glob(os.path.join(REPO, "controller", "*", "conf", "robot.cal")))[-1:]
    if not paths:
        sys.exit("no copy of robot.cal found under controller/: run scripts/a465-getfile /conf/robot.cal")
    for path in paths:
        with open(path, "rb") as source:
            data = source.read()
        print(f"{os.path.relpath(path, REPO)}: {len(data)} bytes, byte sum {sum(data):#x}")
        try:
            print("\n".join("  " + line for line in calfile.describe(calfile.parse(data))))
        except calfile.CalFileError as err:
            sys.exit(f"  not understood: {err}")


if __name__ == "__main__":
    main()
