#!/usr/bin/env python3
"""Calibrate the cell's bench camera (docs/CAMERA.md has the whole procedure).

    a465-camcal target [--outdir DIR] [--what board|marker|both]   printable board and gripper marker
    a465-camcal grab [--url URL] [--out DIR] [--count N --every S]  take pictures, say if the board was found
    a465-camcal lens DIR [--out lens.json] [--force]               lens matrix and distortion
    a465-camcal undistort IMAGE --lens lens.json [--out FILE]      to judge the lens by eye
    a465-camcal robot SAMPLES.json --lens lens.json [--out robot.json]   camera pose in the world frame
    a465-camcal project --lens L --robot R (--point X Y Z | --pose X Y Z YAW PITCH ROLL
                                            | --pixel U V --plane-z Z)

Never touches the serial port or the arm; the only network use is `grab` reading the camera's snapshot.
"""
import argparse
import os
import sys
import time
import urllib.request

import numpy as np

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, REPO)

from a465 import camcal      # noqa: E402

DEFAULT_LENS = os.path.join(camcal.CAMERA_DIR, "lens.json")
DEFAULT_ROBOT = os.path.join(camcal.CAMERA_DIR, "robot.json")


def cmd_target(a):
    for p in camcal.write_targets(a.outdir, which=a.what, dpi=a.dpi,
                                  marker={"marker_mm": a.marker_mm}):
        print("wrote", p)
    print("Print the PDF at 100% (no 'fit to page'), then check the 100 mm line with a ruler.")


def fetch(url):
    with urllib.request.urlopen(url, timeout=10) as r:
        return r.read()


def cmd_grab(a):
    import cv2
    params = camcal.load_board(a.board)
    os.makedirs(a.out, exist_ok=True)
    cov, n = None, 0
    existing = camcal.list_images(a.out)
    nums = [int(os.path.basename(p)[5:-4]) for p in existing if os.path.basename(p)[5:-4].isdigit()]
    n = max(nums, default=0)
    found_total = 0
    for p in existing:                      # take earlier pictures in this directory into the coverage
        img = camcal.read_image(p)
        if cov is None:
            cov = camcal.Coverage((img.shape[1], img.shape[0]))
        c, ids = camcal.detect_board(img, params)
        if len(ids) >= camcal.LENS_MIN_CORNERS:
            cov.add(c)
            found_total += 1
    if existing:
        print("%d pictures already in %s, %d usable; %s" % (len(existing), a.out, found_total, cov.summary()))
    shots = 0
    while True:
        if a.count:
            if shots >= a.count:
                break
            if shots:
                time.sleep(a.every)
        else:
            try:
                s = input("Enter = take a picture, q = finish: ")
            except EOFError:
                break
            if s.strip().lower().startswith("q"):
                break
        try:
            data = fetch(a.url)
        except OSError as e:
            print("could not fetch %s: %s" % (a.url, e))
            if a.count:
                break
            continue
        shots += 1
        n += 1
        path = os.path.join(a.out, "snap_%03d.jpg" % n)
        with open(path, "wb") as f:
            f.write(data)
        img = cv2.imdecode(np.frombuffer(data, np.uint8), cv2.IMREAD_GRAYSCALE)
        if img is None:
            print(path, "not a readable picture")
            continue
        if cov is None:
            cov = camcal.Coverage((img.shape[1], img.shape[0]))
        if (img.shape[1], img.shape[0]) != cov.size:
            print("WARNING: %s is %dx%d, earlier pictures %dx%d" % (path, img.shape[1], img.shape[0], *cov.size))
        c, ids = camcal.detect_board(img, params)
        if len(ids) >= camcal.LENS_MIN_CORNERS:
            found_total += 1
            cov.add(c)
            print("%s: board found, %d corners; %d usable so far; %s" % (path, len(ids), found_total, cov.summary()))
        else:
            print("%s: board NOT found (%d corners; need %d). Saved anyway, ignored by the lens step; "
                  "%d usable so far" % (path, len(ids), camcal.LENS_MIN_CORNERS, found_total))
    if cov:
        print("Finished: %d usable pictures, %s" % (found_total, cov.summary()))


def cmd_lens(a):
    params = camcal.load_board(a.board)
    res = camcal.calibrate_lens_dir(a.dir, params,
                                    progress=lambda p, n: print("%s: %d corners" % (os.path.basename(p), n)))
    k = np.array(res["camera_matrix"])
    print("image size %dx%d, %d usable pictures" % (*res["image_size"], len(res["per_image"])))
    print("fx %.1f fy %.1f cx %.1f cy %.1f" % (k[0, 0], k[1, 1], k[0, 2], k[1, 2]))
    print("distortion k1 k2 p1 p2 k3:", " ".join("%.5f" % v for v in res["dist_coeffs"]))
    print("RMS reprojection error %.3f px (good <= %.1f, expect about 0.2 to 0.5)" %
          (res["rms_px"], camcal.LENS_RMS_MAX_PX))
    for e in res["per_image"]:
        print("  %-14s %.3f px  (%d corners)" % (e["image"], e["rms_px"], e["corners"]))
    print("coverage: %d%% of the frame; corners %s" % (round(100 * res["coverage"]["fraction"]), ", ".join(
        "%s %d%%" % (k_, round(100 * v)) for k_, v in res["coverage"]["corners"].items())))
    if res["good"]:
        print("RESULT: good")
    else:
        print("RESULT: NOT good")
        for p in res["problems"]:
            print("  -", p)
    if res["good"] or a.force:
        camcal.save_json(res, a.out)
        print("saved", a.out, "" if res["good"] else "(marked good: false, because of --force)")
    else:
        print("not saved (use --force to save anyway, marked good: false)")
        return 1


def cmd_undistort(a):
    import cv2
    k, dist, size, _ = camcal.load_lens(a.lens)
    img = cv2.imread(a.image)
    if img is None:
        sys.exit("cannot read " + a.image)
    if (img.shape[1], img.shape[0]) != tuple(size):
        sys.exit("picture is %dx%d, the lens was calibrated at %dx%d" % (img.shape[1], img.shape[0], *size))
    out = a.out or os.path.splitext(a.image)[0] + "_undistorted.png"
    cv2.imwrite(out, camcal.undistort(img, k, dist, a.alpha))
    print("wrote", out, "- judge it by eye: edges that are straight in the room should be straight here")


def cmd_robot(a):
    try:
        res = camcal.solve_robot_file(a.samples, a.lens)
    except camcal.CalibrationError as e:
        print("REFUSED:", e)
        return 1
    print("%d samples used" % res["n_samples"], "(no marker found in: %s)" % ", ".join(res["skipped_no_marker"])
          if res["skipped_no_marker"] else "")
    print("camera position in world (mm): %.1f %.1f %.1f" % tuple(res["camera_position_mm"]))
    print("marker offset from tool point (mm, tool frame): %.1f %.1f %.1f" % tuple(res["marker_offset_mm"]))
    for e in res["per_sample"]:
        print("  %-16s %.2f px  %.1f mm" % (e["sample"], e["px"], e["mm"]))
    print("RMS %.2f px, %.1f mm (limits %.1f px, %.1f mm)" %
          (res["rms_px"], res["rms_mm"], camcal.ROBOT_RMS_MAX_PX, camcal.ROBOT_RMS_MAX_MM))
    if res["good"]:
        print("RESULT: good")
    else:
        print("RESULT: NOT good")
        for p in res["problems"]:
            print("  -", p)
    if res["good"] or a.force:
        camcal.save_json(res, a.out)
        print("saved", a.out)
    else:
        print("not saved (use --force to save anyway, marked good: false)")
        return 1


def cmd_project(a):
    k, dist, size, _ = camcal.load_lens(a.lens)
    t_wc, t_tm, _ = camcal.load_robot(a.robot)
    try:
        if a.pixel:
            if a.plane_z is None:
                sys.exit("--pixel needs --plane-z")
            p = camcal.pixel_to_world_plane(a.pixel, a.plane_z, t_wc, k, dist)[0]
            print("pixel %.1f %.1f on the plane z = %g is world x %.1f y %.1f z %.1f mm" %
                  (*a.pixel, a.plane_z, *p))
            return
        if a.pose:
            t_wt = camcal.pose_matrix(*a.pose)
            px = camcal.world_to_pixel(t_wt[:3, 3], t_wc, k, dist)[0]
            mk = camcal.world_to_pixel((t_wt @ t_tm)[:3, 3], t_wc, k, dist)[0]
            print("tool point appears at pixel %.1f %.1f; marker centre at %.1f %.1f" % (*px, *mk))
        elif a.point:
            px = camcal.world_to_pixel(a.point, t_wc, k, dist)[0]
            print("world point %.1f %.1f %.1f appears at pixel %.1f %.1f" % (*a.point, *px))
        else:
            sys.exit("give --point, --pose or --pixel")
        if not (0 <= px[0] < size[0] and 0 <= px[1] < size[1]):
            print("(outside the %dx%d picture)" % tuple(size))
    except camcal.CalibrationError as e:
        sys.exit(str(e))


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("target", help="write the printable board and marker")
    s.add_argument("--outdir", default=camcal.CAMERA_DIR)
    s.add_argument("--what", choices=("board", "marker", "both"), default="both")
    s.add_argument("--dpi", type=int, default=300)
    s.add_argument("--marker-mm", type=float, default=camcal.DEFAULT_MARKER["marker_mm"])
    s.set_defaults(fn=cmd_target)
    s = sub.add_parser("grab", help="take snapshots and say whether the board was found")
    s.add_argument("--url", default=camcal.CAMERA_URL)
    s.add_argument("--out", default=os.path.join(camcal.CAMERA_DIR, "lens-shots"))
    s.add_argument("--count", type=int, default=0, help="take N pictures without waiting for Enter")
    s.add_argument("--every", type=float, default=3.0, help="seconds between pictures with --count")
    s.add_argument("--board", help="board JSON written by `target` (default: the built-in board)")
    s.set_defaults(fn=cmd_grab)
    s = sub.add_parser("lens", help="compute camera matrix and distortion from a directory of pictures")
    s.add_argument("dir")
    s.add_argument("--out", default=DEFAULT_LENS)
    s.add_argument("--board")
    s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_lens)
    s = sub.add_parser("undistort", help="write the undistorted picture")
    s.add_argument("image")
    s.add_argument("--lens", default=DEFAULT_LENS)
    s.add_argument("--out")
    s.add_argument("--alpha", type=float, default=0.0, help="0 crops to valid pixels, 1 keeps all")
    s.set_defaults(fn=cmd_undistort)
    s = sub.add_parser("robot", help="solve camera pose in the world frame and the marker offset")
    s.add_argument("samples")
    s.add_argument("--lens", default=DEFAULT_LENS)
    s.add_argument("--out", default=DEFAULT_ROBOT)
    s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_robot)
    s = sub.add_parser("project", help="world point to pixel, pixel to world on a plane")
    s.add_argument("--lens", default=DEFAULT_LENS)
    s.add_argument("--robot", default=DEFAULT_ROBOT)
    s.add_argument("--point", type=float, nargs=3, metavar=("X", "Y", "Z"))
    s.add_argument("--pose", type=float, nargs=6, metavar=("X", "Y", "Z", "YAW", "PITCH", "ROLL"))
    s.add_argument("--pixel", type=float, nargs=2, metavar=("U", "V"))
    s.add_argument("--plane-z", type=float)
    s.set_defaults(fn=cmd_project)
    a = ap.parse_args()
    sys.exit(a.fn(a) or 0)


if __name__ == "__main__":
    main()
