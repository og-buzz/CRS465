#!/usr/bin/env python3
"""Bench test of the `jogd` program (a465/jogprog.py) on the real controller. Stand at the E-stop.

    scripts/a465-jogtest --dry                     # start jogd, wait for `jogd ready`, `q`: no motion command is sent
    scripts/a465-jogtest F --speed 2 --hold 1.0    # joint 6 positive: start/stop, dead-man; f is the negative direction
    scripts/a465-jogtest F --speed 2 --speed2 3    # also a speed change (--variant s|r)

See the docstring of a465/jogtest.py. Log: sessions/<time>-jogtest.log. Exit code 0 only if everything ran as expected
and the prompt came back after `q` without Ctrl-Z or Ctrl-E.
"""
import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, REPO)

from a465 import jogtest      # noqa: E402

if __name__ == "__main__":
    sys.exit(jogtest.main(repo=REPO))
