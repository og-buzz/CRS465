#!/usr/bin/env python3
"""Jog the REAL arm with the PlayStation controller, one joint at a time, and watch its home switches.

Same controls as the web page's mock: hold L1 and push a stick (or the D-pad) to move a joint,
let go to stop, Square to stop. L1 + R1 + triggers change the speed (held to 25% while the arm is
not homed). Everything else on the pad is refused here.
L1 + L2 + stick is fine stepping (0.5 degrees a step, no pause afterwards).

Without --zero-at nothing stops a joint short of its hard stop. With it, the program works in true
joint angles and ends a jog 3 degrees inside each joint's range.

Prints where the arm stopped after each jog, and every change of a status bit (such as a home
switch) with the joint angle it happened at. Also written to sessions/<time>-arm-events.csv.
--jogd uses a465/jogd.py instead: a program that runs on the controller (controller/programs/jogd, put there
by this tool when it differs). The stick gives the direction only: every jog runs at the pad's speed setting
(L1 + R1 + L2 / R2, from 1 percent up to --max-speed, which may be at most 99). The controller fixes a jog's speed
when it starts; if the setting is changed by a factor of 1.6 or more for 0.4 s while a joint is moving, the jog is
stopped and started again at the new speed, which costs about half a second of standstill (--no-respeed: never).
With --stick-speed the speed of a jog is instead set when it starts from the largest stick deflection in its first
0.12 s (1 percent at the start of the stick's travel, the speed setting at the end). Delay from stick to motion is
about 0.4 s. It does not apply soft limits and --zero-at only gives true angles.
Frames: the pad's Options button changes the mode (joint, world, tool) and the change is carried out at once: jogd is
quit and started again in the controller's matching manual mode (it takes the mode only when it starts), which takes
about 1.5 s; no jog starts after it until the stick has been let go. World and tool jog the axes through FRAME_AXES in
a465/jogd.py (the signs are not yet confirmed on the arm).
With world or tool in --frames, every frame runs through jogd-c (controller/programs/jogd-c, put on the controller as /tmp/jogd-c
when it differs; --program-c LOCAL names another local file): in those frames a push is ONE straight-line move of 150 mm (45
degrees for rotations) that ends by itself and is started again while the stick is held. Stick X, Y, Z: with two of them
deflected (past the start threshold) the move is a straight line along their direction (an `@` vector); it is stopped and
started again if the sticks stay more than 25 degrees off that direction for 0.3 s. A rotation (D-pad, right stick left /
right) is always one axis, and wins when it is the largest deflection. With only joint in --frames jogd is used, as before.
Joint-limit guard (world and tool frames, on by default, --no-limit-guard turns it off): the controller kills the jog program
when a straight-line move runs a joint into its limit, so the PC stops the move (`.`) when a joint moving toward a limit will be
within 4 degrees of it 0.8 s ahead, and refuses to start a move that would push a joint already inside the margin further toward
its limit (moving the other way is allowed). Limits: GUARD_LIMITS_DEG in a465/jogd.py. The joint frame is not touched.
Speed caps (percent, the speed sent is the smallest of the pad's setting, --max-speed and the cap that applies):
--joint-cap 2=25,3=25 (the default; `none` for no caps) and --frame-cap world=15,tool=15 (the default).
The controller's own messages (for instance "Arm power is OFF") are shown when it kills jogd.
--status-port (default 8466 with --jogd, 0 for off) serves a status page, see a465/indicator.py.
If the controller asks for it, press the PAUSE/CONTINUE button on its front panel; if jogd is killed it restarts
by itself (and asks for the button). Without --jogd nothing changes.
Teach and replay (with --jogd, which then always runs jogd-c on the controller): Share saves the arm's pose as P1, P2 ... (in
--poses FILE, default poses.json in this directory) and selects it; hold L1 + Triangle to go to the selected pose (joint move) or
L1 + R1 + Triangle (straight line), L1 + R1 + Cross selects the next saved pose. Letting go of a button stops the move, a stick
wins over it. --goto-speed 1-50 (default 10) is the speed of a go-to (never above --max-speed). The status page lists the poses.
Stop with Ctrl-C or SIGTERM: the arm is halted and the controller is left at its `$` prompt.
"""
import argparse
import asyncio
import os
import signal
import socket
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from a465 import crs, jogd, poses         # noqa: E402
from a465.gamepad import Gamepad          # noqa: E402
from a465.sim import RobotError           # noqa: E402

START = time.monotonic()


def say(text):
    print(f"{time.monotonic() - START:8.1f}  {text}", flush=True)


def lan_address():
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as probe:
            probe.connect(("192.0.2.1", 9))         # no packet is sent: this only picks the outgoing interface
            return probe.getsockname()[0]
    except OSError:
        return "localhost"


def say_caps(arm):
    joints = arm.joint_caps
    say("speed caps: " + (", ".join(f"joint {j} {c}%" for j, c in sorted(joints.items())) if joints else "no joint caps")
        + "; " + ", ".join(f"{f} frame {c}%" for f, c in arm.frame_caps.items()) + f"; max speed {arm.max_speed}%")
    if arm.limit_guard:
        say("joint-limit guard (world and tool frames): " + ", ".join(f"J{i + 1} {lo:g}..{hi:g}" for i, (lo, hi) in enumerate(arm.guard_limits))
            + f"; margin {jogd.GUARD_MARGIN_DEG:g} deg, look-ahead {jogd.GUARD_LOOKAHEAD_S:g} s")
    else:
        say("joint-limit guard: OFF (--no-limit-guard): a move into a joint limit makes the controller kill the jog program")


async def run(args):
    try:
        zero_at = [float(v) for v in args.zero_at.split(",")] if args.zero_at else None
        if zero_at is not None and len(zero_at) != 6:
            sys.exit("--zero-at needs six numbers, one per joint")
        store = None
        if args.jogd:
            store = poses.PoseStore(args.poses)
            say(f"poses: {store.path}: {len(store)} saved" + (f" (selected {store.selected()})" if store.selected() else ""))
            if store.message:
                say(store.message)
            arm = jogd.JogdArm(args.port, args.baud, say=say, zero_at=zero_at, max_speed=args.max_speed, respeed=not args.no_respeed,
                                  stick_speed=args.stick_speed, joint_caps=args.joint_caps, frame_caps=args.frame_caps,
                                  frames=args.frames, local_c=args.program_c or jogd.LOCAL_C,
                                  limit_guard=not args.no_limit_guard, poses=store, goto_speed=args.goto_speed)
        else:
            arm = crs.RealArm(args.port, args.baud, say=say, zero_at=zero_at)
    except RobotError as err:
        sys.exit(f"cannot start: {err}")
    task = status_task = None
    try:
        arm.speed = args.speed
        if args.jogd:
            say_caps(arm)
        switches = arm.state()["home_switches"]
        say(("connected to the arm, true angles (soft limits on).  " if arm.zero_at and not args.jogd
             else "connected to the arm, true angles, NO soft limits (jogd).  " if arm.zero_at else "connected to the arm, NO soft limits.  ")
            + "  ".join(f"J{i + 1} {a:8.2f}" for i, a in enumerate(arm.true_joints() or arm.joints))
            + ("   home switches " + "".join(str(b) for b in switches) if switches else ""))
        pad = Gamepad(arm, args.gamepad)
        task = asyncio.ensure_future(pad.run())
        if args.status_port:
            def get_state():
                state = arm.state()
                status = pad.status()
                state["pad"] = {"connected": status["connected"], "name": status["name"], "l1": bool(status["enabled"])}
                state["speed"] = arm.speed
                state["selected"] = store.selected() if store is not None else None
                return state
            try:
                from a465 import indicator
                indicator.serve
            except (ImportError, AttributeError) as err:
                print(f"no status page ({err})", flush=True)
            else:
                actions = poses.PoseActions(arm, store) if store is not None else None
                try:
                    page = indicator.serve(get_state, host="0.0.0.0", port=args.status_port, actions=actions)
                except TypeError:                    # a status page without pose support
                    page = indicator.serve(get_state, host="0.0.0.0", port=args.status_port)
                status_task = asyncio.ensure_future(page)
                status_task.add_done_callback(lambda t: t.cancelled() or not t.exception() or say(f"the status page stopped: {t.exception()!r}"))
                say(f"status page: http://{lan_address()}:{args.status_port}")
        stop = asyncio.Event()
        for sig in (signal.SIGINT, signal.SIGTERM):
            asyncio.get_running_loop().add_signal_handler(sig, stop.set)
        last = None
        frame_seen = getattr(arm, "frame", None)
        while not stop.is_set() and not task.done():
            status = pad.status()
            if args.jogd and status["frame"] != frame_seen:      # the switch happens at the button press, not at the next push
                frame_seen = status["frame"]
                try:
                    arm.set_frame(frame_seen)
                except RobotError as err:
                    say(f"cannot change frame: {err}")
            goto = arm.state().get("goto") if args.jogd else None
            goto_text = (f"{goto['name']} {'arrived' if goto['arrived'] else 'running' if goto['running'] else 'starting'}"
                         + (" (line)" if goto["straight"] else "")) if goto else ""
            now = (status["connected"], status["name"], status["message"], status["enabled"], status["frame"], arm.speed, arm.notice,
                   store.selected() if store is not None else None, goto_text)
            if now != last:
                say(f"pad: {'connected' if now[0] else 'NOT connected'} ({now[1]})  L1 {'held' if now[3] else 'up'}  mode {now[4]}  speed {now[5]}%"
                    + (f"  | {now[2]}" if now[2] else "") + (f"  | arm: {now[6]}" if now[6] else "")
                    + (f"  | pose {now[7]}" if now[7] else "") + (f"  | go-to {now[8]}" if now[8] else ""))
                last = now
            await asyncio.sleep(0.1)
        if task.done() and not task.cancelled() and task.exception():
            say(f"the controller-pad reader failed: {task.exception()!r}")
    finally:                                  # whatever happens, stop the arm and leave the controller's shell properly
        for t in (task, status_task):
            if t is not None:
                t.cancel()
        arm.close()
        say("stopped; the controller is back at its system prompt")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--port", default=os.environ.get("A465_PORT", "/dev/ttyUSB0"))
    ap.add_argument("--baud", type=int, default=38400)
    ap.add_argument("--speed", type=int, default=10, choices=range(1, 100), metavar="PERCENT",
                    help=f"starting speed (default 10); at most {crs.MAX_SPEED_PCT} without --jogd, at most --max-speed with it")
    ap.add_argument("--zero-at", metavar="J1,J2,J3,J4,J5,J6",
                    help="the controller's reading of each joint at the true zero pose (arm straight up, every joint mid-travel); "
                         "use 0,0,0,0,0,0 after /diag/zero at that pose. Turns on soft limits")
    ap.add_argument("--jogd", action="store_true", help="jog through the jogd program on the controller: proportional speed, less delay")
    ap.add_argument("--no-respeed", action="store_true", help="with --jogd: never change the speed of a jog that is running (it stays what the first 0.12 s picked)")
    ap.add_argument("--stick-speed", action="store_true",
                    help="with --jogd: how far the stick is pushed sets the speed of a jog when it starts. Without it the stick "
                         "gives the direction only and every jog runs at the pad's speed setting (L1 + R1 + L2 / R2)")
    ap.add_argument("--frames", default="joint", metavar="joint[,world,tool]",
                    help="with --jogd: the frames the Options button may use (default joint only: world and tool stay off "
                         "until a bench run has confirmed what each axis does on this arm)")
    ap.add_argument("--program-c", metavar="LOCAL", default=None,
                    help="with --jogd and world or tool in --frames: the local jogd-c file to use (default controller/programs/jogd-c)")
    ap.add_argument("--max-speed", type=int, default=jogd.DEFAULT_MAX_SPEED, choices=range(1, 101), metavar="1-100",
                    help="with --jogd: the most speed (percent) the arm is ever sent, also jogd's own clamp (default %(default)s)")
    ap.add_argument("--joint-cap", metavar="J=PCT,...", default=None,
                    help="with --jogd: speed cap (percent, 1 to 99) per joint in the joint frame, like 2=25,3=25 (the default); `none` for no caps")
    ap.add_argument("--frame-cap", metavar="FRAME=PCT,...", default=None,
                    help="with --jogd: speed cap (percent, 1 to 99) for the world and tool frames, like world=15,tool=15 (the default)")
    ap.add_argument("--no-limit-guard", action="store_true",
                    help="with --jogd: turn the joint-limit guard off (in world and tool frames the PC otherwise stops a move before a joint "
                         "reaches its limit, and refuses a start that would push further into one)")
    ap.add_argument("--poses", metavar="FILE", default=None,
                    help=f"with --jogd: the file of saved poses (default {poses.DEFAULT_PATH})")
    ap.add_argument("--goto-speed", type=int, default=jogd.DEFAULT_GOTO_SPEED, choices=range(1, 51), metavar="1-50",
                    help="with --jogd: the speed (percent) of a go-to to a saved pose (default %(default)s; never above --max-speed)")
    ap.add_argument("--status-port", type=int, default=None, metavar="PORT",
                    help="serve the arm's status page on this port (default 8466 with --jogd; 0 turns it off)")
    ap.add_argument("--gamepad", metavar="DEVICE", help="input device to use instead of the first controller found")
    args = ap.parse_args()
    if not args.jogd and (args.max_speed != jogd.DEFAULT_MAX_SPEED or args.no_respeed or args.stick_speed
                          or args.joint_cap is not None or args.frame_cap is not None or args.no_limit_guard
                          or args.poses is not None or args.goto_speed != jogd.DEFAULT_GOTO_SPEED):
        ap.error("--max-speed, --no-respeed, --stick-speed, --joint-cap, --frame-cap, --no-limit-guard, --poses and --goto-speed need --jogd")
    try:
        args.joint_caps = None if args.joint_cap is None else jogd.parse_joint_caps(args.joint_cap)
        args.frame_caps = None if args.frame_cap is None else jogd.parse_frame_caps(args.frame_cap)
    except ValueError as err:
        ap.error(str(err))
    args.frames = tuple(f.strip() for f in args.frames.split(",") if f.strip())
    if "joint" not in args.frames or any(f not in jogd.FRAME_MODE for f in args.frames):
        ap.error(f"--frames must include joint and come from {', '.join(jogd.FRAME_MODE)}")
    if args.program_c is not None and not (args.jogd and {"world", "tool"} & set(args.frames)):
        ap.error("--program-c needs --jogd and world or tool in --frames")
    if args.status_port is None:
        args.status_port = 8466 if args.jogd else 0
    if not 0 <= args.status_port <= 65535:
        ap.error("--status-port must be 0 to 65535")
    if args.jogd and args.max_speed > jogd.TOP_SPEED:
        print(f"--max-speed {args.max_speed}: jogd's command carries two digits, so {jogd.TOP_SPEED} is the top; using {jogd.TOP_SPEED}")
        args.max_speed = jogd.TOP_SPEED
    if args.speed > (args.max_speed if args.jogd else crs.MAX_SPEED_PCT):
        ap.error(f"--speed {args.speed} is above the limit of {args.max_speed if args.jogd else crs.MAX_SPEED_PCT}")
    asyncio.run(run(args))


if __name__ == "__main__":
    main()
