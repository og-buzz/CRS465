#!/usr/bin/env python3
"""Zero one joint's position counter with the controller's own `/diag/xzero <axis>`. Nothing moves.

    scripts/a465-xzero <1..6>

For a joint whose counter no longer matches where the joint really is: put the joint on its zero mark
first, then run this. Only that joint's counter changes (the controller's help: "Zeros the position
registers of a particular robot axis"). If the controller asks for PAUSE/CONTINUE, it is waited for.
Every byte goes to sessions/<time>-xzero.log. Exit code 0 only if the joint then reads 0.000.
"""
import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, REPO)

from a465 import home      # noqa: E402

if __name__ == "__main__":
    sys.exit(home.xzero_main(repo=REPO))
