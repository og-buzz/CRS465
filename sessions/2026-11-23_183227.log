# Rotate the aci daemon log files:
rm /log/acid.log.2
mv -f /log/acid.log.1 /log/acid.log.2
mv -f /log/acid.log.0 /log/acid.log.1
mv -f /log/acid.log   /log/acid.log.0
# Start the aci daemon
/sbin/fastacid -q &
# Start the robot server
/sbin/robotsrv &
msleep 1000
/sbin/f3adjust
# Start the teach pendant:
pendant &
Hit <space> or <q>
[no prompt within 20 s]                    msleep 500

exit
